+/// Touch mode (phones and tablets, set by the web host): fingers are wider than a mouse pointer,
+/// so widgets accept a press a little outside their rect, window and panel edges are easier to
+/// grab and scroll bars are solid and wide enough for a thumb. Layout sizes stay as they are, so
+/// every panel keeps its desktop arrangement; the host scales the whole UI with egui's zoom factor.
+static TOUCH_MODE: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// Turn touch mode on or off; the next [`apply_kind`] (or [`restyle_for_touch`]) uses it.
+pub fn set_touch_mode(on: bool) {
+    TOUCH_MODE.store(on, std::sync::atomic::Ordering::Relaxed);
+}
+
+/// Whether touch mode is on ([`set_touch_mode`]).
+pub fn touch_mode() -> bool {
+    TOUCH_MODE.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+/// How a photo cell (grid, filmstrip) senses the pointer. With a mouse: clicks, and drags that
+/// carry the selection to a sidebar row. In touch mode only taps: a finger drag must scroll the
+/// grid or the filmstrip (a cell that took drags left nothing to swipe), and a long press opens the
+/// photo's menu with the same actions.
+pub fn photo_cell_sense() -> egui::Sense {
+    if touch_mode() { egui::Sense::click() } else { egui::Sense::click_and_drag() }
+}
+
+/// The touch adjustments of [`apply_kind`], for a style already themed.
+fn touch_style(s: &mut egui::Style) {
+    s.interaction.interact_radius = 10.0;
+    s.interaction.resize_grab_radius_side = 12.0;
+    s.interaction.resize_grab_radius_corner = 16.0;
+    // tooltips need a hover a finger can't make; a long press opens the context menu instead
+    s.interaction.show_tooltips_only_when_still = true;
+    s.interaction.tooltip_delay = 0.8;
+    s.spacing.scroll = egui::style::ScrollStyle::solid();
+    s.spacing.scroll.bar_width = 12.0;
+    s.spacing.scroll.handle_min_length = 32.0;
+}
+
+/// Restyle `ctx` for the current touch mode without changing its theme (the host calls this
+/// after [`set_touch_mode`]; a theme change later keeps it through [`apply_kind`]).
+pub fn restyle_for_touch(ctx: &egui::Context) {
+    match current(ctx) {
+        Some(kind) => apply_kind(ctx, kind),
+        None if touch_mode() => ctx.all_styles_mut(touch_style),
+        None => {}
+    }
+}
+
 /// Style `ctx` with `kind`. The visuals go to both of egui's styles, so egui following the
 /// system's dark/light setting on its own never swaps in its stock look.
 pub fn apply_kind(ctx: &egui::Context, kind: ThemeKind) {
@@ -489,6 +536,9 @@ pub fn apply_kind(ctx: &egui::Context, kind: ThemeKind) {
         s.text_styles.insert(egui::TextStyle::Small, FontId::proportional(11.0));
         s.text_styles.insert(egui::TextStyle::Heading, FontId::new(16.0, FontFamily::Name(FONT_SEMIBOLD.into())));
         s.animation_time = 0.08;
+        if touch_mode() {
+            touch_style(s);
+        }
     });
 }
 
diff --git a/crates/ui-egui/src/touch_bar.rs b/crates/ui-egui/src/touch_bar.rs
new file mode 100644
index 0000000..db847e3
--- /dev/null
+++ b/crates/ui-egui/src/touch_bar.rs
@@ -0,0 +1,193 @@
+//! The touch bar: a small floating bar for phones and tablets ([`crate::theme::touch_mode`]).
+//!
+//! On a desktop much of LightCraft is a key away (G, D, Escape, \, Cmd+Z…). A finger has no
+//! keyboard, so the bar puts those commands under the thumb. Every button runs the same command
+//! id as its menu item or shortcut ([`LightcraftApp::run`]), so nothing here behaves differently
+//! from the desktop app. It starts folded to one round handle; a tap opens it, a drag on the
+//! handle moves it out of the way, and where it was left is kept for the session.
+
+use egui::{Align2, CornerRadius, Id, Order, Pos2, Rect, Stroke, Vec2, vec2};
+use serde_json::json;
+
+use crate::LightcraftApp;
+use crate::i18n::tr;
+
+/// One button of the bar: command id, label (English, translated through [`tr`]) and whether it
+/// shows as on/off from [`crate::menubar::checked`].
+struct Button {
+    id: &'static str,
+    label: &'static str,
+    toggle: bool,
+}
+
+const fn b(id: &'static str, label: &'static str, toggle: bool) -> Button {
+    Button { id, label, toggle }
+}
+
+/// The bar's rows: views, history and import; panels; the loupe.
+const ROWS: [&[Button]; 3] = [
+    &[
+        b("view.gridToggle", "Grid", false),
+        b("view.detail", "Edit", false),
+        b("view.back", "Back", false),
+        b("edit.undo", "Undo", false),
+        b("edit.redo", "Redo", false),
+        b("file.addPhotos", "Import Photos…", false),
+    ],
+    &[
+        b("view.leftPanel", "My Photos Panel", false),
+        b("view.rightPanel", "Tools", false),
+        b("view.filmstrip", "Filmstrip", false),
+        b("view.enterFullScreen", "Enter Full Screen", true),
+    ],
+    &[
+        b("view.showOriginal", "Show Original", true),
+        b("view.zoomFit", "Fit", false),
+        b("view.zoomToggle", "Toggle Zoom", false),
+        b("app.settings", "Settings…", false),
+        b(GESTURE_SETTINGS, "Apple Pencil & Gestures…", false),
+    ],
+];
+
+/// Not a command: the button that asks the host for its gesture settings (which action Apple
+/// Pencil's double-tap and squeeze and the two- and three-finger taps run). The browser host
+/// shows them ([`take_gesture_settings_request`]).
+pub const GESTURE_SETTINGS: &str = "touch.gestureSettings";
+
+fn gesture_settings_id() -> Id {
+    Id::unique("lightcraft-touch-bar-gesture-settings")
+}
+
+/// Whether the gesture settings were asked for since the last call (the host opens them).
+pub fn take_gesture_settings_request(ctx: &egui::Context) -> bool {
+    ctx.data_mut(|d| d.remove_temp::<bool>(gesture_settings_id())).unwrap_or(false)
+}
+
+/// Side of the round handle, in points (a comfortable fingertip).
+const HANDLE: f32 = 44.0;
+
+fn open_id() -> Id {
+    Id::unique("lightcraft-touch-bar-open")
+}
+
+/// Whether the bar is open (unfolded).
+pub fn is_open(ctx: &egui::Context) -> bool {
+    ctx.data(|d| d.get_temp::<bool>(open_id())).unwrap_or(false)
+}
+
+/// Draw the bar over everything else when touch mode is on; a no-op otherwise.
+pub fn show(app: &mut LightcraftApp, ctx: &egui::Context) {
+    if !crate::theme::touch_mode() {
+        return;
+    }
+    let screen = ctx.content_rect();
+    let open = is_open(ctx);
+    // start at the bottom right, above the bottom bar and clear of the home indicator
+    let start = Pos2::new(screen.right() - HANDLE - 16.0, screen.bottom() - HANDLE - 56.0);
+    let area = egui::Area::new(Id::unique("lightcraft-touch-bar"))
+        .order(Order::Foreground)
+        .default_pos(start)
+        .movable(true)
+        .constrain(true)
+        .pivot(Align2::LEFT_TOP);
+    let mut run: Option<&'static str> = None;
+    let mut toggle_open = false;
+    area.show(ctx, |ui| {
+        let t = ui.visuals().clone();
+        egui::Frame::new()
+            .fill(t.window_fill.gamma_multiply(0.96))
+            .stroke(Stroke::new(1.0, t.window_stroke.color))
+            .corner_radius(CornerRadius::same(if open { 12 } else { 22 }))
+            .shadow(t.popup_shadow)
+            .inner_margin(if open { 8 } else { 0 })
+            .show(ui, |ui| {
+                if open {
+                    ui.spacing_mut().button_padding = vec2(12.0, 8.0);
+                    ui.spacing_mut().item_spacing = vec2(6.0, 6.0);
+                    ui.horizontal(|ui| {
+                        ui.label(egui::RichText::new("LightCraft").strong());
+                        ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+                            if ui.add(egui::Button::new(egui::RichText::new("×").size(20.0)).min_size(vec2(36.0, 36.0))).clicked() {
+                                toggle_open = true;
+                            }
+                        });
+                    });
+                    for row in ROWS {
+                        ui.horizontal_wrapped(|ui| {
+                            for button in row {
+                                let on = button.toggle && crate::menubar::checked(app, button.id) == Some(true);
+                                let enabled = button.id == GESTURE_SETTINGS || crate::menus::ui_enabled(app, button.id);
+                                let label = egui::RichText::new(tr(button.label)).size(15.0);
+                                let w = egui::Button::selectable(on, label).min_size(vec2(44.0, 40.0));
+                                if ui.add_enabled(enabled, w).clicked() {
+                                    run = Some(button.id);
+                                }
+                            }
+                        });
+                    }
+                } else {
+                    let (rect, resp) = ui.allocate_exact_size(Vec2::splat(HANDLE), egui::Sense::click());
+                    paint_handle(ui, rect, resp.hovered() || resp.is_pointer_button_down_on());
+                    if resp.clicked() {
+                        toggle_open = true;
+                    }
+                }
+            });
+    });
+    if toggle_open {
+        ctx.data_mut(|d| d.insert_temp(open_id(), !open));
+    }
+    if run == Some(GESTURE_SETTINGS) {
+        ctx.data_mut(|d| d.insert_temp(gesture_settings_id(), true));
+        ctx.request_repaint();
+    } else if let Some(id) = run {
+        if let Err(e) = app.run(id, json!({})) {
+            app.toast(ctx, e);
+        }
+        ctx.request_repaint();
+    }
+}
+
+/// Fit a desktop layout to a small screen (`width` points across): below a tablet's width the
+/// My Photos panel and the filmstrip start hidden so the photo and the Edit panel get the room,
+/// and the Edit panel is kept no wider than the screen allows. Both come back from the bar.
+pub fn fit_layout_to_screen(app: &mut LightcraftApp, width: f32) {
+    if !width.is_finite() || width <= 0.0 {
+        return;
+    }
+    if width < 760.0 {
+        app.ui.left_panel = false;
+        app.ui.filmstrip = false;
+    }
+    let room = (width * 0.62).max(crate::state::RIGHT_WIDTH.min);
+    if app.ui.right_width > room {
+        app.ui.right_width = room;
+    }
+}
+
+/// Three dots in a circle: the folded bar.
+fn paint_handle(ui: &egui::Ui, rect: Rect, active: bool) {
+    let p = ui.painter();
+    let c = rect.center();
+    let fg = if active { ui.visuals().selection.stroke.color } else { ui.visuals().text_color() };
+    for dx in [-9.0, 0.0, 9.0] {
+        p.circle_filled(c + vec2(dx, 0.0), 2.6, fg);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::ROWS;
+
+    /// Every button runs a command the app knows (a UI command or one of the engine's).
+    #[test]
+    fn every_button_is_a_known_command() {
+        let ui: Vec<&str> = crate::menus::ui_commands().map(|c| c.0).collect();
+        for row in ROWS {
+            for b in row {
+                let known = ui.contains(&b.id) || matches!(b.id, "edit.undo" | "edit.redo" | super::GESTURE_SETTINGS);
+                assert!(known, "{} is not a command", b.id);
+            }
+        }
+    }
+}
