@@ -0,0 +1,647 @@
+//! Phones and tablets (iPhone, iPad, Android): the browser host's side of LightCraft's touch
+//! support. The page (`index.html`) works out what the device is and keeps a little state the
+//! browser only reports to its own event handlers; this module reads it each frame:
+//!
+//! - `globalThis.lightcraftMobile = { touch, phone, tablet, ios, zoom, stylus }`: `touch` turns on
+//!   [`lightcraft_ui_egui::theme::set_touch_mode`] and the floating touch bar, `zoom` scales the UI
+//!   (egui's zoom factor), `stylus` says the touch in progress is an Apple Pencil (or another pen).
+//! - `globalThis.lightcraftFullscreen = { set(on), active() }`: full screen through the browser's
+//!   Fullscreen API, for View ▸ Enter Full Screen and the touch bar (eframe's web runner ignores
+//!   `ViewportCommand::Fullscreen`).
+//!
+//! Every read is fallible: a page without these objects (an older `index.html`, a host page that
+//! embeds the canvas) runs exactly as the desktop-browser build did.
+
+use js_sys::Reflect;
+use lightcraft_ui_egui::LightcraftApp;
+use wasm_bindgen::{JsCast, JsValue};
+
+/// `globalThis[name]`, if the page set it.
+fn global(name: &str) -> Option<JsValue> {
+    Reflect::get(&js_sys::global(), &JsValue::from_str(name)).ok().filter(|v| v.is_object())
+}
+
+fn flag(obj: &JsValue, key: &str) -> bool {
+    Reflect::get(obj, &JsValue::from_str(key)).ok().and_then(|v| v.as_bool()).unwrap_or(false)
+}
+
+fn number(obj: &JsValue, key: &str) -> Option<f64> {
+    Reflect::get(obj, &JsValue::from_str(key)).ok().and_then(|v| v.as_f64()).filter(|v| v.is_finite())
+}
+
+/// Call `obj[key](args…)`; `None` when it isn't a function or throws.
+fn call(obj: &JsValue, key: &str, args: &[JsValue]) -> Option<JsValue> {
+    let f = Reflect::get(obj, &JsValue::from_str(key)).ok()?.dyn_into::<js_sys::Function>().ok()?;
+    let list = js_sys::Array::new();
+    for a in args {
+        list.push(a);
+    }
+    f.apply(obj, &list).ok()
+}
+
+/// What the page found out about the device.
+#[derive(Clone, Copy, Debug, Default)]
+pub(crate) struct Device {
+    /// A touch screen is the main input (phone, tablet; not a laptop with a touch screen).
+    pub touch: bool,
+    /// A small screen (shorter side under 600 CSS px).
+    pub phone: bool,
+    /// iOS or iPadOS (Safari and every other iOS browser are WebKit, with its memory limits).
+    pub ios: bool,
+    /// The UI scale the page chose (1 = desktop size).
+    pub zoom: f32,
+}
+
+impl Device {
+    /// Read `globalThis.lightcraftMobile` (a desktop browser without it: no touch, zoom 1).
+    pub fn read() -> Device {
+        let Some(m) = global("lightcraftMobile") else { return Device { zoom: 1.0, ..Device::default() } };
+        let zoom = number(&m, "zoom").map_or(1.0, |z| z.clamp(0.5, 3.0) as f32);
+        Device { touch: flag(&m, "touch"), phone: flag(&m, "phone"), ios: flag(&m, "ios"), zoom }
+    }
+
+    /// At most this many render workers: each is a second copy of the module with its own
+    /// memory, and mobile browsers close a tab that uses too much.
+    pub fn max_workers(&self) -> usize {
+        if self.phone {
+            1
+        } else if self.ios || self.touch {
+            2
+        } else {
+            4
+        }
+    }
+
+    /// The main thread's memory budget for original photo bytes.
+    pub fn originals_budget(&self) -> usize {
+        if self.phone {
+            192 << 20
+        } else if self.touch || self.ios {
+            256 << 20
+        } else {
+            768 << 20
+        }
+    }
+
+    /// Phones and tablets only: the engine's memory budget on the main thread (its caches get
+    /// half). The engine's default is a quarter of RAM up to 1.5 GB, and the browser doesn't tell
+    /// a page how much RAM there is, so a page took the full 1.5 GB: too much for iOS, which then
+    /// freezes or closes the page.
+    pub fn main_budget(&self) -> Option<usize> {
+        if self.phone {
+            Some(448 << 20)
+        } else if self.touch || self.ios {
+            Some(640 << 20)
+        } else {
+            None
+        }
+    }
+
+    /// Phones and tablets only: each render worker's engine memory budget, in MB.
+    pub fn worker_budget_mb(&self) -> Option<u32> {
+        if self.phone {
+            Some(320)
+        } else if self.touch || self.ios {
+            Some(448)
+        } else {
+            None
+        }
+    }
+
+    /// Phones and tablets only: a worker whose WebAssembly memory has grown past this many bytes
+    /// is replaced by a fresh one once it is idle. WebAssembly memory only grows: one huge raw
+    /// leaves the worker that decoded it holding that much for the rest of the session.
+    pub fn recycle_bytes(&self) -> Option<usize> {
+        if self.phone {
+            Some(640 << 20)
+        } else if self.touch || self.ios {
+            Some(900 << 20)
+        } else {
+            None
+        }
+    }
+}
+
+/// The worker settings [`setup`] chose (read by `workers.rs` when it starts workers):
+/// engine budget per worker in MB and the recycle threshold in bytes (0: none, desktop).
+static WORKER_BUDGET_MB: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+static RECYCLE_BYTES: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+
+/// Each render worker's engine memory budget in MB (`None`: the engine's default).
+pub(crate) fn worker_budget_mb() -> Option<u32> {
+    Some(WORKER_BUDGET_MB.load(std::sync::atomic::Ordering::Relaxed)).filter(|m| *m > 0)
+}
+
+/// Replace an idle worker whose memory grew past this many bytes (`None`: never).
+pub(crate) fn recycle_bytes() -> Option<usize> {
+    Some(RECYCLE_BYTES.load(std::sync::atomic::Ordering::Relaxed)).filter(|b| *b > 0)
+}
+
+/// Set up the UI for the device once, when the app starts: touch styling, the UI scale and a
+/// layout that fits a small screen.
+pub(crate) fn setup(ctx: &egui::Context, app: &mut LightcraftApp, device: Device) {
+    crate::store::set_mem_budget(device.originals_budget());
+    if let Some(b) = device.main_budget() {
+        app.session.set_memory_budget(b);
+    }
+    WORKER_BUDGET_MB.store(device.worker_budget_mb().unwrap_or(0), std::sync::atomic::Ordering::Relaxed);
+    RECYCLE_BYTES.store(device.recycle_bytes().unwrap_or(0), std::sync::atomic::Ordering::Relaxed);
+    if !device.touch {
+        return;
+    }
+    lightcraft_ui_egui::theme::set_touch_mode(true);
+    lightcraft_ui_egui::theme::restyle_for_touch(ctx);
+    if (device.zoom - 1.0).abs() > f32::EPSILON {
+        ctx.set_zoom_factor(device.zoom);
+    }
+    // the page's width in points once zoomed
+    let width = web_sys::window().and_then(|w| w.inner_width().ok()).and_then(|v| v.as_f64()).unwrap_or(1024.0) as f32 / device.zoom;
+    lightcraft_ui_egui::touch_bar::fit_layout_to_screen(app, width);
+    log::info!(
+        "lightcraft: touch device (phone: {}, iOS: {}), UI zoom {:.2}, {width:.0} points wide, memory {} MB + {} MB per worker",
+        device.phone,
+        device.ios,
+        device.zoom,
+        device.main_budget().unwrap_or(0) >> 20,
+        device.worker_budget_mb().unwrap_or(0)
+    );
+}
+
+/// Full screen, each frame before the app's logic: hand a requested change (View ▸ Enter Full
+/// Screen, the touch bar) to the page, and tell the app whether the page is in full screen now
+/// (Escape or the browser's own controls can leave it at any time).
+pub(crate) fn sync_fullscreen(app: &mut LightcraftApp) {
+    let Some(fs) = global("lightcraftFullscreen") else { return };
+    if let Some(on) = app.ui.window_fullscreen.take() {
+        let _ = call(&fs, "set", &[JsValue::from_bool(on)]);
+    }
+    if let Some(active) = call(&fs, "active", &[]).and_then(|v| v.as_bool()) {
+        app.window_is_fullscreen = active;
+    }
+}
+
+/// A finger on an iPhone or iPad reports a touch force of 0 (and some Android screens report
+/// their own numbers): only a pen's force is pen pressure. Without a pen the force is dropped, so
+/// a finger paints a mask at full pressure like a mouse; with an Apple Pencil it passes through
+/// and the brush follows how hard the Pencil presses.
+pub(crate) fn pen_pressure_only(raw: &mut egui::RawInput) {
+    let stylus = global("lightcraftMobile").is_some_and(|m| flag(&m, "stylus"));
+    if stylus {
+        return;
+    }
+    for e in &mut raw.events {
+        if let egui::Event::Touch { force, .. } = e {
+            *force = None;
+        }
+    }
+}
+
+// ------------------------------------------------------------------ multi-finger taps
+
+/// A multi-finger tap: two fingers or three. What it does is the person's choice
+/// ([`gesture_action`]; by default two fingers undo and three redo, as in drawing apps on iPad).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum TapAction {
+    Undo,
+    Redo,
+}
+
+impl TapAction {
+    /// The gesture's name in the person's settings ([`GESTURE_DEFAULTS`]).
+    pub fn gesture(self) -> &'static str {
+        match self {
+            TapAction::Undo => "twoFingerTap",
+            TapAction::Redo => "threeFingerTap",
+        }
+    }
+}
+
+// ------------------------------------------------------------------ gesture settings
+
+/// The gestures the person can give an action to, with their default action. Apple Pencil's
+/// double-tap and squeeze reach a page only through the LightCraft Pencil companion app (iPadOS
+/// gives them to native apps only; it calls `lightcraftPencil(...)` in the page).
+pub(crate) const GESTURE_DEFAULTS: [(&str, &str); 4] =
+    [("pencilDoubleTap", "undo"), ("pencilSqueeze", "original"), ("twoFingerTap", "undo"), ("threeFingerTap", "redo")];
+
+/// What an action does: a command (the same as its menu item), a key (as if typed) or nothing.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum GestureAct {
+    Command(&'static str),
+    Key(egui::Key),
+    Nothing,
+}
+
+/// An action by its name in the settings, with the label its notice shows (English, translated).
+pub(crate) fn action(name: &str) -> (GestureAct, &'static str) {
+    match name {
+        "undo" => (GestureAct::Command("edit.undo"), "Undo"),
+        "redo" => (GestureAct::Command("edit.redo"), "Redo"),
+        "original" => (GestureAct::Command("view.showOriginal"), "Show Original"),
+        "back" => (GestureAct::Command("view.back"), "Back"),
+        "next" => (GestureAct::Key(egui::Key::ArrowRight), "Next Photo"),
+        "previous" => (GestureAct::Key(egui::Key::ArrowLeft), "Previous Photo"),
+        "zoom" => (GestureAct::Command("view.zoomToggle"), "Toggle Zoom"),
+        "fit" => (GestureAct::Command("view.zoomFit"), "Zoom to Fit"),
+        "tools" => (GestureAct::Command("view.rightPanel"), "Tools"),
+        "filmstrip" => (GestureAct::Command("view.filmstrip"), "Filmstrip"),
+        _ => (GestureAct::Nothing, ""),
+    }
+}
+
+/// The action the person chose for `gesture` (`lightcraftMobile.gestures`, kept by the page in
+/// the browser's storage), else its default.
+pub(crate) fn gesture_action(gesture: &str) -> String {
+    let chosen = global("lightcraftMobile")
+        .and_then(|m| Reflect::get(&m, &JsValue::from_str("gestures")).ok())
+        .filter(|g| g.is_object())
+        .and_then(|g| Reflect::get(&g, &JsValue::from_str(gesture)).ok())
+        .and_then(|v| v.as_string());
+    chosen.unwrap_or_else(|| GESTURE_DEFAULTS.iter().find(|(g, _)| *g == gesture).map_or("none", |(_, a)| a).to_string())
+}
+
+/// Show the page's gesture settings (`lightcraftMobile.openGestureSettings()`).
+pub(crate) fn open_gesture_settings() {
+    if let Some(m) = global("lightcraftMobile") {
+        let _ = call(&m, "openGestureSettings", &[]);
+    }
+}
+
+thread_local! {
+    /// Gestures the page reported (Apple Pencil, through the companion app), not run yet.
+    static INBOX: std::cell::RefCell<Vec<String>> = const { std::cell::RefCell::new(Vec::new()) };
+}
+
+/// Queue a gesture reported by the page (`lightcraft_gesture` in `web.rs`).
+pub(crate) fn push_gesture(name: String) {
+    INBOX.with(|q| q.borrow_mut().push(name));
+}
+
+/// The gestures queued since the last frame.
+pub(crate) fn take_gestures() -> Vec<String> {
+    INBOX.with(|q| std::mem::take(&mut *q.borrow_mut()))
+}
+
+/// A key typed by an action: pressed and released.
+pub(crate) fn key_events(key: egui::Key) -> [egui::Event; 2] {
+    let ev = |pressed| egui::Event::Key { key, physical_key: None, pressed, repeat: false, modifiers: egui::Modifiers::default() };
+    [ev(true), ev(false)]
+}
+
+/// A finger's press is held back this long: a second finger landing in that time makes the
+/// touch a gesture (pinch, two- or three-finger tap), which must not also tap a button, select a
+/// photo or zoom the loupe with the first finger.
+const HOLD_MS: f64 = 70.0;
+/// A multi-finger tap: all fingers up within this time, none moved further (points).
+const TAP_MS: f64 = 450.0;
+const TAP_SLOP: f32 = 24.0;
+
+#[derive(Default)]
+struct Gestures {
+    /// Fingers down: id → (where it landed, where it is).
+    active: std::collections::HashMap<u64, (egui::Pos2, egui::Pos2)>,
+    started_ms: f64,
+    max_fingers: usize,
+    moved: f32,
+    /// The first finger's press, not passed on yet, and when it came.
+    held: Option<(egui::Event, f64)>,
+    /// A multi-finger gesture: pointer presses and releases are dropped until every finger is up.
+    gesture: bool,
+    pointer: Option<egui::Pos2>,
+}
+
+thread_local! {
+    static GESTURES: std::cell::RefCell<Gestures> = std::cell::RefCell::new(Gestures::default());
+}
+
+fn now_ms() -> f64 {
+    js_sys::Date::now()
+}
+
+/// What the page knows about the fingers and pens on the screen right now
+/// (`lightcraftMobile.touchIds`, kept by `index.html` from every touch event the browser sends).
+pub(crate) struct LiveTouches {
+    /// The ids of the touches on the screen now (`Touch.identifier`); `None`: the page doesn't say.
+    pub ids: Option<Vec<i32>>,
+    /// The last pointer pressed was a mouse or trackpad (an iPad's, or a computer's).
+    pub mouse: bool,
+    /// A Pencil (or other pen) is the touch in progress.
+    pub stylus: bool,
+}
+
+impl LiveTouches {
+    fn read() -> LiveTouches {
+        let Some(m) = global("lightcraftMobile") else { return LiveTouches { ids: None, mouse: false, stylus: false } };
+        let ids = Reflect::get(&m, &JsValue::from_str("touchIds"))
+            .ok()
+            .filter(js_sys::Array::is_array)
+            .map(|v| js_sys::Array::from(&v).iter().filter_map(|x| x.as_f64()).map(|x| x as i32).collect());
+        let mouse = Reflect::get(&m, &JsValue::from_str("pointerType")).ok().and_then(|v| v.as_string()).is_some_and(|t| t == "mouse");
+        LiveTouches { ids, mouse, stylus: flag(&m, "stylus") }
+    }
+}
+
+/// Filter this frame's input for multi-finger gestures (before the app sees it). Returns the tap
+/// action, if a two- or three-finger tap just ended, and whether a held press needs another frame
+/// soon (the caller requests one). Mouse, trackpad and Apple Pencil input passes untouched.
+/// `pointer_down`: egui holds a button down (from the frames before).
+pub(crate) fn filter_gestures(raw: &mut egui::RawInput, pointer_down: bool) -> (Option<TapAction>, bool) {
+    let live = LiveTouches::read();
+    GESTURES.with(|g| filter_with(&mut g.borrow_mut(), raw, &live, pointer_down, now_ms()))
+}
+
+fn filter_with(g: &mut Gestures, raw: &mut egui::RawInput, live: &LiveTouches, pointer_down: bool, now: f64) -> (Option<TapAction>, bool) {
+    let stylus = live.stylus;
+    use egui::{Event, TouchPhase};
+    // eframe sends a finger's press together with its touch start, in the same frame
+    let finger_down = raw.events.iter().any(|e| matches!(e, Event::Touch { phase: TouchPhase::Start, .. }));
+    let mut out = Vec::with_capacity(raw.events.len() + 2);
+    let mut action = None;
+    let mut ended = false;
+    for e in raw.events.drain(..) {
+        match &e {
+            Event::Touch { id, phase, pos, .. } => {
+                match phase {
+                    TouchPhase::Start => {
+                        if g.active.is_empty() {
+                            g.started_ms = now;
+                            g.max_fingers = 0;
+                            g.moved = 0.0;
+                            g.gesture = false;
+                        }
+                        g.active.insert(id.0, (*pos, *pos));
+                        g.max_fingers = g.max_fingers.max(g.active.len());
+                        // a second finger while the first one's press is still held: a gesture
+                        if g.active.len() >= 2 && g.held.take().is_some() {
+                            g.gesture = true;
+                        }
+                    }
+                    TouchPhase::Move => {
+                        if let Some((start, last)) = g.active.get_mut(&id.0) {
+                            *last = *pos;
+                            g.moved = g.moved.max(start.distance(*pos));
+                        }
+                    }
+                    TouchPhase::End | TouchPhase::Cancel => {
+                        g.active.remove(&id.0);
+                        if g.active.is_empty() && g.gesture {
+                            let quick = now - g.started_ms <= TAP_MS && g.moved <= TAP_SLOP;
+                            if quick && *phase == TouchPhase::End {
+                                action = match g.max_fingers {
+                                    2 => Some(TapAction::Undo),
+                                    3 => Some(TapAction::Redo),
+                                    _ => None,
+                                };
+                            }
+                            ended = true;
+                        }
+                    }
+                }
+                out.push(e);
+            }
+            Event::PointerMoved(p) => {
+                g.pointer = Some(*p);
+                out.push(e);
+            }
+            Event::PointerButton { pressed: true, .. } if finger_down && !stylus => {
+                if g.gesture || g.active.len() >= 2 {
+                    g.gesture = true; // dropped: part of a gesture
+                } else {
+                    g.held = Some((e, now));
+                }
+            }
+            Event::PointerButton { pressed: false, .. } if g.gesture || ended => {}
+            Event::PointerButton { pressed: false, .. } => {
+                // a quick tap: its press first, then the release (a click)
+                if let Some((press, _)) = g.held.take() {
+                    push_press(&mut out, press, g.pointer);
+                }
+                out.push(e);
+            }
+            _ => out.push(e),
+        }
+    }
+    if ended {
+        g.gesture = false;
+        g.held = None;
+        out.push(Event::PointerGone);
+    }
+    reconcile(g, &mut out, live, pointer_down);
+    // held long enough with one finger: it's a touch on whatever is under it
+    if let Some((_, t)) = &g.held
+        && now - *t >= HOLD_MS
+        && let Some((press, _)) = g.held.take()
+    {
+        push_press(&mut out, press, g.pointer);
+    }
+    raw.events = out;
+    (action, g.held.is_some())
+}
+
+/// Close the touches the browser never said were over. eframe passes a touch's end only when the
+/// finger lifts inside the canvas (not in the margins around it, by the notch or the home bar),
+/// and turns a cancelled touch (iOS cancels touches all the time: palm rejection with Apple
+/// Pencil, system gestures, an alert) into no release at all. egui then holds the button down
+/// for good: the slider that was dragged never ends its drag, nothing else can be tapped, and
+/// the app waits for a finger that is gone. The page knows the touches that are really down;
+/// any other touch is cancelled here, and a button held by a touch is released once no finger
+/// or pen is on the screen.
+fn reconcile(g: &mut Gestures, out: &mut Vec<egui::Event>, live: &LiveTouches, pointer_down: bool) {
+    use egui::{Event, TouchPhase};
+    let Some(ids) = &live.ids else { return };
+    let on_screen: std::collections::HashSet<u64> = ids.iter().map(|&i| egui::TouchId::from(i).0).collect();
+    let stale: Vec<u64> = g.active.keys().filter(|id| !on_screen.contains(id)).copied().collect();
+    for id in stale {
+        if let Some((_, last)) = g.active.remove(&id) {
+            out.push(Event::Touch {
+                device_id: egui::TouchDeviceId(0),
+                id: egui::TouchId(id),
+                phase: TouchPhase::Cancel,
+                pos: last,
+                force: None,
+            });
+        }
+    }
+    if !on_screen.is_empty() || live.mouse {
+        return;
+    }
+    // no finger or pen on the screen: nothing of a touch is held any more
+    if g.gesture || g.held.is_some() {
+        g.gesture = false;
+        g.held = None;
+    }
+    let released = out.iter().any(|e| matches!(e, Event::PointerButton { pressed: false, .. }));
+    let pressed = out.iter().any(|e| matches!(e, Event::PointerButton { pressed: true, .. }));
+    if pointer_down && !released && !pressed {
+        let pos = g.pointer.unwrap_or(egui::Pos2::ZERO);
+        out.push(Event::PointerButton { pos, button: egui::PointerButton::Primary, pressed: false, modifiers: egui::Modifiers::default() });
+        out.push(Event::PointerGone);
+    }
+}
+
+/// Pass on a held press: at the place the finger landed, then to where it is now, so a slider or
+/// a pan that started moving during the hold follows from its start.
+fn push_press(out: &mut Vec<egui::Event>, press: egui::Event, now_at: Option<egui::Pos2>) {
+    let start = match &press {
+        egui::Event::PointerButton { pos, .. } => Some(*pos),
+        _ => None,
+    };
+    if let Some(p) = start {
+        out.push(egui::Event::PointerMoved(p));
+    }
+    out.push(press);
+    if let Some(q) = now_at
+        && start.is_some_and(|p| p.distance(q) > 0.5)
+    {
+        out.push(egui::Event::PointerMoved(q));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use egui::{Event, PointerButton, Pos2, RawInput, TouchDeviceId, TouchId, TouchPhase, pos2};
+
+    fn touch(id: u64, phase: TouchPhase, pos: Pos2) -> Event {
+        Event::Touch { device_id: TouchDeviceId(0), id: TouchId(id), phase, pos, force: None }
+    }
+    fn button(pressed: bool, pos: Pos2) -> Event {
+        Event::PointerButton { pos, button: PointerButton::Primary, pressed, modifiers: Default::default() }
+    }
+    fn frame(g: &mut Gestures, events: Vec<Event>, now: f64) -> (Vec<Event>, Option<TapAction>) {
+        // (the page doesn't report its touches here: no reconciliation)
+        let live = LiveTouches { ids: None, mouse: false, stylus: false };
+        let mut raw = RawInput { events, ..Default::default() };
+        let (a, _) = filter_with(g, &mut raw, &live, false, now);
+        (raw.events, a)
+    }
+
+    fn frame_live(g: &mut Gestures, events: Vec<Event>, ids: &[i32], pointer_down: bool, now: f64) -> Vec<Event> {
+        let live = LiveTouches { ids: Some(ids.to_vec()), mouse: false, stylus: false };
+        let mut raw = RawInput { events, ..Default::default() };
+        filter_with(g, &mut raw, &live, pointer_down, now);
+        raw.events
+    }
+    fn releases(ev: &[Event]) -> usize {
+        ev.iter().filter(|e| matches!(e, Event::PointerButton { pressed: false, .. })).count()
+    }
+    fn presses(ev: &[Event]) -> usize {
+        ev.iter().filter(|e| matches!(e, Event::PointerButton { pressed: true, .. })).count()
+    }
+
+    #[test]
+    fn a_quick_one_finger_tap_still_clicks() {
+        let mut g = Gestures::default();
+        let p = pos2(10.0, 10.0);
+        let (a, _) = frame(&mut g, vec![button(true, p), touch(1, TouchPhase::Start, p)], 0.0);
+        assert_eq!(presses(&a), 0, "held");
+        let (b, act) = frame(&mut g, vec![button(false, p), touch(1, TouchPhase::End, p)], 30.0);
+        assert_eq!(presses(&b), 1);
+        assert!(b.iter().any(|e| matches!(e, Event::PointerButton { pressed: false, .. })));
+        assert_eq!(act, None);
+    }
+
+    #[test]
+    fn a_held_finger_presses_after_the_hold() {
+        let mut g = Gestures::default();
+        let p = pos2(10.0, 10.0);
+        frame(&mut g, vec![button(true, p), touch(1, TouchPhase::Start, p)], 0.0);
+        let (a, _) = frame(&mut g, vec![], HOLD_MS + 1.0);
+        assert_eq!(presses(&a), 1);
+    }
+
+    #[test]
+    fn two_fingers_tapping_undo_and_never_click() {
+        let mut g = Gestures::default();
+        let (p, q) = (pos2(10.0, 10.0), pos2(60.0, 10.0));
+        let (a, _) = frame(&mut g, vec![button(true, p), touch(1, TouchPhase::Start, p)], 0.0);
+        let (b, _) = frame(&mut g, vec![touch(2, TouchPhase::Start, q)], 20.0);
+        let (c, act) = frame(&mut g, vec![button(false, p), touch(1, TouchPhase::End, p), touch(2, TouchPhase::End, q)], 120.0);
+        for ev in [&a, &b, &c] {
+            assert_eq!(presses(ev), 0);
+            assert!(!ev.iter().any(|e| matches!(e, Event::PointerButton { pressed: false, .. })));
+        }
+        assert_eq!(act, Some(TapAction::Undo));
+    }
+
+    #[test]
+    fn three_fingers_redo_and_a_pinch_does_nothing() {
+        let mut g = Gestures::default();
+        let ps = [pos2(10.0, 10.0), pos2(40.0, 10.0), pos2(70.0, 10.0)];
+        frame(&mut g, vec![button(true, ps[0]), touch(1, TouchPhase::Start, ps[0])], 0.0);
+        frame(&mut g, vec![touch(2, TouchPhase::Start, ps[1]), touch(3, TouchPhase::Start, ps[2])], 15.0);
+        let (_, act) =
+            frame(&mut g, vec![touch(1, TouchPhase::End, ps[0]), touch(2, TouchPhase::End, ps[1]), touch(3, TouchPhase::End, ps[2])], 100.0);
+        assert_eq!(act, Some(TapAction::Redo));
+        // a pinch: two fingers that move apart
+        frame(&mut g, vec![button(true, ps[0]), touch(1, TouchPhase::Start, ps[0])], 1000.0);
+        frame(&mut g, vec![touch(2, TouchPhase::Start, ps[1])], 1010.0);
+        frame(&mut g, vec![touch(2, TouchPhase::Move, pos2(140.0, 10.0))], 1100.0);
+        let (_, act) = frame(&mut g, vec![touch(1, TouchPhase::End, ps[0]), touch(2, TouchPhase::End, pos2(140.0, 10.0))], 1200.0);
+        assert_eq!(act, None);
+    }
+
+    #[test]
+    fn a_finger_lifted_outside_the_canvas_is_released() {
+        // a slider drag whose finger lifted by the home bar: eframe sent no end and no release
+        let mut g = Gestures::default();
+        let p = pos2(10.0, 10.0);
+        frame_live(&mut g, vec![button(true, p), touch(7, TouchPhase::Start, p)], &[7], false, 0.0);
+        frame_live(&mut g, vec![], &[7], true, HOLD_MS + 1.0);
+        frame_live(&mut g, vec![Event::PointerMoved(pos2(10.0, 500.0)), touch(7, TouchPhase::Move, pos2(10.0, 500.0))], &[7], true, 120.0);
+        let ev = frame_live(&mut g, vec![], &[], true, 200.0);
+        assert_eq!(releases(&ev), 1, "the button is released");
+        assert!(ev.iter().any(|e| matches!(e, Event::Touch { phase: TouchPhase::Cancel, .. })), "the touch is closed");
+        assert!(g.active.is_empty());
+        // and the next tap works again
+        let q = pos2(50.0, 50.0);
+        frame_live(&mut g, vec![button(true, q), touch(8, TouchPhase::Start, q)], &[8], false, 1000.0);
+        let ev = frame_live(&mut g, vec![button(false, q), touch(8, TouchPhase::End, q)], &[], false, 1030.0);
+        assert_eq!(presses(&ev), 1);
+        assert_eq!(releases(&ev), 1);
+    }
+
+    #[test]
+    fn a_cancelled_touch_doesnt_leave_a_gesture_behind() {
+        // iOS cancels a palm while the Pencil draws: the second "finger" never ends
+        let mut g = Gestures::default();
+        let (p, q) = (pos2(10.0, 10.0), pos2(300.0, 300.0));
+        frame_live(&mut g, vec![button(true, p), touch(1, TouchPhase::Start, p)], &[1], false, 0.0);
+        frame_live(&mut g, vec![touch(2, TouchPhase::Start, q)], &[1, 2], false, 20.0);
+        // both gone, no end for either
+        frame_live(&mut g, vec![], &[], false, 300.0);
+        assert!(g.active.is_empty() && !g.gesture);
+        let r = pos2(80.0, 80.0);
+        let a = frame_live(&mut g, vec![button(true, r), touch(3, TouchPhase::Start, r)], &[3], false, 1000.0);
+        assert_eq!(presses(&a), 0, "held as a normal touch, not dropped as a gesture");
+        let b = frame_live(&mut g, vec![button(false, r), touch(3, TouchPhase::End, r)], &[], false, 1030.0);
+        assert_eq!(presses(&b), 1);
+    }
+
+    #[test]
+    fn a_mouse_held_down_is_never_released_for_it() {
+        let mut g = Gestures::default();
+        let live = LiveTouches { ids: Some(vec![]), mouse: true, stylus: false };
+        let mut raw = RawInput { events: vec![], ..Default::default() };
+        filter_with(&mut g, &mut raw, &live, true, 0.0);
+        assert_eq!(releases(&raw.events), 0);
+    }
+
+    #[test]
+    fn every_default_action_does_something() {
+        for (gesture, default) in GESTURE_DEFAULTS {
+            assert_ne!(action(default).0, GestureAct::Nothing, "{gesture}");
+        }
+        assert_eq!(action("none").0, GestureAct::Nothing);
+        assert_eq!(action("bogus").0, GestureAct::Nothing);
+        assert_eq!(TapAction::Undo.gesture(), "twoFingerTap");
+    }
+
+    #[test]
+    fn mouse_and_trackpad_clicks_pass_untouched() {
+        let mut g = Gestures::default();
+        let p = pos2(5.0, 5.0);
+        let (a, _) = frame(&mut g, vec![button(true, p)], 0.0);
+        assert_eq!(presses(&a), 1);
+    }
+}
