new file mode 100644
index 0000000..cc3277d
--- /dev/null
+++ b/apps/lightcraft-web/sw.js
@@ -0,0 +1,60 @@
+// LightCraft's service worker: makes the installed app open without a network connection.
+// The bundle's file names are the same in every version, so it asks the network first (a new
+// release is picked up as soon as you are online) and falls back to the copy it kept.
+// The library itself is not here: it lives in the browser's storage (OPFS / IndexedDB).
+const CACHE = "lightcraft-app-v2";
+const CORE = [
+  "./",
+  "./index.html",
+  "./worker.js",
+  "./lightcraft_web.js",
+  "./lightcraft_web_bg.wasm",
+  "./manifest.webmanifest",
+  "./icons/icon-192.png",
+  "./icons/icon-512.png",
+  "./icons/apple-touch-icon.png",
+];
+
+self.addEventListener("install", (event) => {
+  event.waitUntil(
+    caches.open(CACHE)
+      // one missing file (a font-free build has no Chinese font) must not stop the install
+      .then((cache) => Promise.all(CORE.map((url) => cache.add(new Request(url, { cache: "reload" })).catch(() => {}))))
+      .then(() => self.skipWaiting()),
+  );
+});
+
+self.addEventListener("activate", (event) => {
+  event.waitUntil(
+    caches.keys()
+      .then((keys) => Promise.all(keys.filter((k) => k.startsWith("lightcraft-app-") && k !== CACHE).map((k) => caches.delete(k))))
+      .then(() => self.clients.claim()),
+  );
+});
+
+self.addEventListener("fetch", (event) => {
+  const req = event.request;
+  if (req.method !== "GET") return;
+  const url = new URL(req.url);
+  if (url.origin !== self.location.origin) return;
+  event.respondWith((async () => {
+    const cache = await caches.open(CACHE);
+    try {
+      const res = await fetch(req, { cache: "no-cache" });
+      if (res.ok && res.type === "basic") {
+        // keep a copy only when the file changed: the app module is about 13 MB, and copying it
+        // on every start costs the iPad memory and time for nothing
+        const kept = await cache.match(req);
+        const tag = (r) => r && (r.headers.get("etag") || r.headers.get("last-modified"));
+        if (!kept || !tag(res) || tag(kept) !== tag(res)) cache.put(req, res.clone()).catch(() => {});
+      }
+      return res;
+    } catch (err) {
+      // offline: the kept copy (the app page for any URL of it, e.g. with ?store=idb)
+      const hit = (await cache.match(req, { ignoreSearch: true })) ||
+        (req.mode === "navigate" ? await cache.match("./index.html") : undefined);
+      if (hit) return hit;
+      throw err;
+    }
+  })());
+});
